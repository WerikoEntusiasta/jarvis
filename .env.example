# ==========================================
# J.A.R.V.I.S. HUD & CORE CONFIGURATION
# Copie este arquivo para .env e preencha com os valores reais.
# Nunca confirme o .env real em repositorios.
# ==========================================

# Porta HTTP do Painel HUD
PORT=8080

# Servidor ZimaOS & OpenClaw
ZIMA_IP=
ZIMA_USER=
# Senha SSH do Zima (usada por deploy_zima.py e test_ssh_zima.py; nunca commitar)
ZIMA_SSH_PASSWORD=
ZIMA_PASS=

# Credenciais Pluggy Open Finance
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=
PLUGGY_API_KEY=
NINEROUTER_API_KEY=
# Painel Lucia (leitura via PIN; nunca commitar valor real)
LUCIA_HUB_URL=http://172.17.0.1:8088
LUCIA_API_PIN=

# ElevenLabs (voz J.A.R.V.I.S. - George)
ELEVENLABS_API_KEY=
ELEVENLABS_FALLBACK_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# URL do Servidor HUD para o MCP
HUD_SERVER_URL=http://localhost:8080
MCP_PORT=8081
# Núcleo único: voz/ilha/canvas do Windows falam com o Core
JARVIS_CORE_URL=https://jarvis.werikspace.xyz

# Esfera J.A.R.V.I.S. — conexão direta, criptografada e autenticada
SPHERE_WS_HOST=0.0.0.0
SPHERE_WS_PORT=8096
SPHERE_WS_CERTFILE=/app/sphere-tls/fullchain.pem
SPHERE_WS_KEYFILE=/app/sphere-tls/privkey.pem
SPHERE_DEVICE_TOKENS=
SPHERE_WAKEWORD_THRESHOLD=0.30
SPHERE_FOLLOWUP_SECONDS=8
SPHERE_WAKEWORD_MODEL=
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_TIMEOUT_SECONDS=25

# Opcional: ativar somente depois de habilitar o endpoint OpenAI-compatible
# do OpenClaw e guardar um token de operador no .env local (nunca no firmware).
SPHERE_OPENCLAW_STREAM_URL=
SPHERE_OPENCLAW_STREAM_TOKEN=
SPHERE_OPENCLAW_MODEL=openclaw/jarvis

# RBAC (sessões e confiança do nó local)
# JARVIS_TRUST_LOCAL=1        # 0 = exige sessão assinada até para 127.0.0.1
# JARVIS_SESSION_SECRET=      # gerado automaticamente em auth/session_secret.key
# JARVIS_SESSION_TTL_S=43200  # validade da sessão (12h)
