# ==============================================================================
# J.A.R.V.I.S. ECOSYSTEM CONFIGURATION TEMPLATE (.env.example)
# Padrão Permanente de Engenharia de Software Sênior
#
# INSTRUÇÕES:
# Copie este arquivo para .env e preencha com as credenciais reais do seu ambiente.
# NUNCA commite o arquivo .env preenchido em repositórios públicos ou versionados.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações da Estação Windows Local (Camada 1)
# ------------------------------------------------------------------------------
PORT=8085
HUD_SERVER_URL=http://localhost:8085
MCP_PORT=8081
LOCAL_SERVER_BIND=127.0.0.1
ENROLLMENT_PORTAL_ENABLED=true
JARVIS_TRUST_LOCAL=1

# ------------------------------------------------------------------------------
# 2. Configurações do Servidor Central ZimaOS Docker (Camada 2)
# ------------------------------------------------------------------------------
ZIMA_IP=45.167.187.80
ZIMA_USER=root
ZIMA_SSH_PORT=28222
# Senha de SSH do servidor ZimaOS (nunca versionar o valor real)
ZIMA_SSH_PASSWORD=
ZIMA_PASS=

# Portas de serviço no ZimaOS
SCREEN_ROUTER_PORT=8095
LUCIA_HUB_URL=http://172.17.0.1:8088
LUCIA_API_PIN=

# ------------------------------------------------------------------------------
# 3. Motores de Inteligência Artificial e Síntese de Voz (TTS / STT)
# ------------------------------------------------------------------------------
# ElevenLabs API (Voz J.A.R.V.I.S. - George ou customizada)
ELEVENLABS_API_KEY=
ELEVENLABS_FALLBACK_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Whisper STT (Transcrição de voz neural)
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# 4. Esfera Física ESP32-S3 (Camada 3 - WebSocket & OTA)
# ------------------------------------------------------------------------------
SPHERE_WS_HOST=45.167.187.80
SPHERE_WS_PORT=8095
SPHERE_WAKEWORD_THRESHOLD=0.30
SPHERE_FOLLOWUP_SECONDS=8

# ------------------------------------------------------------------------------
# 5. Integrações Financeiras e Automações Externas (Opcionais)
# ------------------------------------------------------------------------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=
PLUGGY_API_KEY=
NINEROUTER_API_KEY=
